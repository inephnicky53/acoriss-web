# Site Configuration
NEXT_PUBLIC_SITE_URL=https://www.acoriss.com
NEXT_PUBLIC_SITE_NAME=Acoriss

# Contact
NEXT_PUBLIC_CONTACT_EMAIL=contact@acoriss.com
NEXT_PUBLIC_CONTACT_PHONE=+243828280000

# Google Maps (à configurer)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_api_key_here

# Google Analytics (à configurer)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Supabase (si utilisé pour le formulaire de contact)
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Email Service (pour le formulaire de contact)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password

# API Keys (si nécessaire)
# API_SECRET_KEY=your_secret_key

